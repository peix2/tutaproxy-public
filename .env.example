# tuta-proxy — konfiguracja
# Skopiuj ten plik jako .env i dostosuj wartości.
# Zmienne środowiskowe mają priorytet nad .env.

# ---------------------------------------------------------------------------
# Serwer IMAP (Thunderbird → localhost:1143)
# ---------------------------------------------------------------------------

TUTA_IMAP_HOST=127.0.0.1
TUTA_IMAP_PORT=1143

# Ścieżka do bazy SQLite z lokalnymi flagami (\Flagged, \Answered).
# Możesz podać ścieżkę absolutną np. /home/user/.tuta-proxy/cache.db
TUTA_CACHE_PATH=tuta_cache.db

# ---------------------------------------------------------------------------
# Serwer SMTP (Thunderbird → localhost:1025)
# ---------------------------------------------------------------------------

TUTA_SMTP_HOST=127.0.0.1
TUTA_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Wersje API Tuty (normalnie nie trzeba zmieniać)
# Gdy proxy przestanie działać po aktualizacji Tuty, zaktualizuj tu.
# Aktualne wartości znajdziesz w type_models/*.json w repo tutanota.
# ---------------------------------------------------------------------------

# TUTA_SYS_VERSION=150
# TUTA_TUTANOTA_VERSION=108
# TUTA_STORAGE_VERSION=14
# TUTA_CLIENT_VERSION=346.260428.0

# ---------------------------------------------------------------------------
# Logi
# ---------------------------------------------------------------------------

# INFO — normalna praca, WARNING — tylko błędy, DEBUG — pełne logi (dużo!)
LOG_LEVEL=INFO

# Jeśli ustawiony, logi trafiają TYLKO do pliku (nie na stderr).
# Odkomentuj i podaj ścieżkę jeśli chcesz logować do pliku.
# LOG_FILE=tuta-proxy.log
